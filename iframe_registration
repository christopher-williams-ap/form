<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SaaS Marketing Dashboard</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
      height: 100vh;
      background-color: #f8fafc;
    }

    /* Sidebar */
    .sidebar {
      width: 250px;
      background-color: #1e293b;
      color: white;
      display: flex;
      flex-direction: column;
      padding: 20px 0;
    }

    .sidebar h2 {
      text-align: center;
      font-size: 1.2em;
      margin-bottom: 30px;
    }

    .nav {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .nav li {
      padding: 15px 25px;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .nav li:hover {
      background-color: #334155;
    }

    .nav li.active {
      background-color: #0ea5e9;
      font-weight: bold;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .main-content iframe {
      border: none;
      flex: 1;
      width: 100%;
    }

    .header {
      background-color: #f1f5f9;
      padding: 15px 25px;
      font-size: 1.1em;
      font-weight: bold;
      border-bottom: 1px solid #e2e8f0;
    }
  </style>
</head>
<body>
  <aside class="sidebar">
    <h2>Marketing Suite</h2>
    <ul class="nav">
      <li>Dashboard</li>
      <li>Campaigns</li>
      <li>Analytics</li>
      <li class="active">Sign up for TrustedForm</li>
      <li>Settings</li>
    </ul>
  </aside>

  <section class="main-content">
    <div class="header">Sign up for TrustedForm</div>
    <iframe src="http://account.activeprospect.com/register" title="TrustedForm Registration"></iframe>
  </section>
</body>
</html>
